PORT=3000
TENANT_ROOT_DOMAIN=2fast.xyz
ENVIRONMENT=local
APP_BASE_URL=
WEBHOOK_URL=
API_BASE_PATH=/api
# Versioned compatibility aliases are also available at /api/v1/*
ENABLE_API_DOCS=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://2fast.xyz,https://*.2fast.xyz
OFFICIAL_META_ONLY=true

# Supabase runtime
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_xxx
SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
SUPABASE_PROJECT_REF=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
VITE_SUPABASE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxx

# WABA / Meta
WABA_VERIFY_TOKEN=replace_me
WABA_APP_ID=replace_me
WABA_APP_SECRET=replace_me
WABA_TOKEN_ENCRYPTION_KEY=replace_me
WABA_API_VERSION=v25.0
WABA_OAUTH_REDIRECT_URI=
WABA_OAUTH_RETURN_URL=
META_WEBHOOK_VERIFY_TOKEN=replace_me
META_APP_ID=replace_me
META_APP_SECRET=replace_me
META_GRAPH_VERSION=v24.0
META_WA_EMBEDDED_SIGNUP_V4_CONFIGURATION_ID=
META_WA_COEXISTENCE_CONFIGURATION_ID=
META_WA_EXISTING_APP_CONFIGURATION_ID=
ENCRYPTION_KEY=
VITE_META_APP_ID=
VITE_META_GRAPH_VERSION=v24.0
VITE_META_WA_EMBEDDED_SIGNUP_V4_CONFIGURATION_ID=
VITE_META_WA_COEXISTENCE_CONFIGURATION_ID=
VITE_META_WA_EXISTING_APP_CONFIGURATION_ID=
VITE_WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]}]
NEXT_PUBLIC_META_WA_COEXISTENCE_CONFIGURATION_ID=

# Optional socket sync tuning (lower values reduce login DB load)
SOCKET_FULL_HISTORY_LIMIT=60
SOCKET_DELTA_HISTORY_LIMIT=40

# Optional native push (FCM for Android + iOS/APNs via Firebase)
# Use one of:
# - FCM_SERVICE_ACCOUNT_JSON (raw JSON content)
# - FCM_SERVICE_ACCOUNT_BASE64 (base64 JSON content)
# - FCM_SERVICE_ACCOUNT_FILE (absolute path to service account file)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_BASE64=
FCM_SERVICE_ACCOUNT_FILE=

# Optional Cloudflare R2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional Supabase clone script inputs
SUPABASE_ACCESS_TOKEN=
TARGET_SUPABASE_ORG_ID=
TARGET_SUPABASE_PROJECT_NAME=qmessage-clone
TARGET_SUPABASE_REGION=ap-southeast-1
TARGET_SUPABASE_DB_PASSWORD=
SOURCE_SUPABASE_DB_URL=
TARGET_SUPABASE_DB_URL=
TARGET_SUPABASE_PROJECT_REF=
