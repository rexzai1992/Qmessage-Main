  "actions": [
    {
      "type": "send_buttons",
      "text": "Hi, thanks for your interest in QPay. We help businesses run counter POS, mobile POS, self-order kiosk, QR ordering, and more. How can I help you today?",
      "buttons": [
        {
          "id": "know_product",
          "title": "Know Product"
        },
        {
          "id": "recommend_setup",
          "title": "Recommend Setup"
        },
        {
          "id": "book_demo",
          "title": "Book Demo"
        }
      ],
      "fallback_text": "Please tap one of the options so I can help you faster.",
      "routes": {
        "know_product": 1,
        "recommend_setup": 7,
        "book_demo": 13
      }
    },
    {
      "type": "send_text",
      "text": "QPay is an all-in-one commerce system for businesses that want POS, kiosk, QR ordering, webstore, inventory, loyalty, and reporting in one ecosystem.",
      "next_step": 2
    },
    {
      "type": "send_buttons",
      "text": "Which part would you like to know more about?",
      "buttons": [
        {
          "id": "counter_pos",
          "title": "Counter POS"
        },
        {
          "id": "self_order_kiosk",
          "title": "Self-order Kiosk"
        },
        {
          "id": "all_in_one",
          "title": "All-in-One Setup"
        }
      ],
      "fallback_text": "Please choose one option below.",
      "routes": {
        "counter_pos": 3,
        "self_order_kiosk": 4,
        "all_in_one": 5
      }
    },
    {
      "type": "send_text",
      "text": "Our counter POS setup is great for cashier flow, inventory control, payment tracking, receipts, and daily sales reporting. It suits stores and front-counter operations that need fast checkout.",
      "next_step": 6
    },
    {
      "type": "send_text",
      "text": "Our kiosk setup helps customers order by themselves, reduces queue congestion, and improves upsell opportunities. It works well for high-traffic F&B and self-service environments.",
      "next_step": 6
    },
    {
      "type": "send_text",
      "text": "Our all-in-one setup combines counter POS, mobile ordering, kiosk, QR ordering, loyalty, and reporting into one connected system so your business can scale without switching platforms.",
      "next_step": 6
    },
    {
      "type": "send_buttons",
      "text": "Would you like to get pricing, book a showroom demo, or talk to sales?",
